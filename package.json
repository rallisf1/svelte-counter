{
    "name": "svelte-counter",
    "version": "2.0.0",
    "description": "Dynamic count-up component for Svelte 5",
    "repository": {
        "type": "git",
        "url": "https://github.com/rallisf1/svelte-counter"
    },
    "homepage": "",
    "bugs": {
